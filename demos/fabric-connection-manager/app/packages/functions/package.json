{
  "name": "@rayfin-app/functions",
  "version": "0.0.0",
  "description": "Thin authenticated admission logging for deferred notebook deletion requests",
  "private": true,
  "type": "module",
  "main": "dist/function_app.js",
  "exports": {
    ".": "./dist/function_app.js",
    "./types": { "types": "./dist/types.d.ts", "default": "./dist/types.js" }
  },
  "scripts": {
    "prebuild": "node ../../scripts/deployment-config.mjs",
    "pretest": "node ../../scripts/deployment-config.mjs",
    "prebuild:watch": "node ../../scripts/deployment-config.mjs",
    "build": "tsc --build",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@microsoft/fabric-user-data-functions": "1.36.2",
    "@microsoft/rayfin-auth": "1.36.2",
    "@microsoft/rayfin-lib": "1.36.2",
    "@rayfin-app/shared": "*",
    "jose": "^6.1.3",
    "mssql": "^12.6.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.9",
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.0",
    "typescript": "~5.7.2",
    "vitest": "^3.2.3"
  }
}
