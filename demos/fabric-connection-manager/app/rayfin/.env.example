# Copy to .env in this directory. Never add real deployment values to Git.
CONNECTION_MANAGER_WORKSPACE_ID=
CONNECTION_MANAGER_LAKEHOUSE_ID=
CONNECTION_MANAGER_SQL_ENDPOINT_ID=
CONNECTION_MANAGER_SQL_DATABASE_ID=
# Existing deployment: use its exact HTTPS hosting origin, without a trailing slash.
# First deployment: localhost is sufficient; Rayfin adds the new hosting origin.
CONNECTION_MANAGER_APP_ORIGIN=http://localhost:5173
